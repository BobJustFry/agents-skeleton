{
  "_comment": "Karkas integration-guard config. 'patterns' are case-insensitive regexes, each with a 'class' (build | test | deploy | install; any other name works too). A pattern is matched against ONE normalized command segment: the Bash/PowerShell command is split on ; | & and newlines (quote-aware), then env assignments, wrappers (npx, pnpm exec, uv run, time, sudo, cmd /c, bash -c ...) and the program path/extension are stripped, so a call of C:/x/dotnet.exe with 'build' is seen as 'dotnet build'. A matching command is blocked unless .claude/team/state/integration-gate lists its class. 'allow' = regexes that exempt a segment. Project-specific additions go to .claude/team/integration-commands.local.json (same keys, merged), which the kit installer never overwrites. Deliberately NOT covered: git push, npm ci / npm install / pip install, tsc, lint and format, dev servers, bare 'cargo build' / 'go build', single-file or filtered test runs, typecheck with --noEmit.",
  "gate_ttl_hours": 12,
  "allow": [
    "(?:^|\\s)--dry-run(?:=\\S+)?(?:\\s|$)",
    "(?:^|\\s)(?:--help|--version)(?:\\s|$)"
  ],
  "patterns": [
    { "class": "build", "pattern": "^(?:npm|pnpm|yarn|bun)\\s+(?:-{1,2}[\\w-]+(?:=\\S+)?\\s+(?:[^\\s-]\\S*\\s+)?)*(?:run(?:-script)?\\s+(?:-{1,2}[\\w-]+\\s+)*)?build(?::\\S+)?(?:\\s|$)" },
    { "class": "build", "pattern": "^(?:vite|next|nuxt|nuxi|astro|ng|gatsby|ember|parcel|webpack|rollup|react-scripts|vue-cli-service|ionic|tauri|cargo-tauri)\\s+build(?:\\s|$)" },
    { "class": "build", "pattern": "^(?:nx|turbo)\\s+(?:run\\s+)?\\S*build\\S*" },
    { "class": "build", "pattern": "^electron-builder(?:\\s|$)" },
    { "class": "build", "pattern": "^electron-forge\\s+(?:make|package)(?:\\s|$)" },
    { "class": "build", "pattern": "^vsce\\s+package(?:\\s|$)" },
    { "class": "build", "pattern": "^eas\\s+build(?:\\s|$)" },
    { "class": "build", "pattern": "^dotnet\\s+(?:publish|pack)(?:\\s|$)" },
    { "class": "build", "pattern": "^dotnet\\s+build(?:\\s|$)(?!.*\\.(?:cs|vb|fs)proj\\b)" },
    { "class": "build", "pattern": "^(?:msbuild|xbuild)(?:\\s|$)(?!.*\\.(?:cs|vb|fs)proj\\b)" },
    { "class": "build", "pattern": "^gradlew?\\s+(?:\\S+\\s+)*?(?::?[\\w-]+:)*(?:assemble|bundle|build|publish)\\w*(?:\\s|$)" },
    { "class": "build", "pattern": "^mvnw?\\s+(?:\\S+\\s+)*?(?:package|install)(?:\\s|$)" },
    { "class": "build", "pattern": "^flutter\\s+build(?:\\s|$)" },
    { "class": "build", "pattern": "^xcodebuild\\s+(?:\\S+\\s+)*?(?:archive|build|-exportArchive)(?:\\s|$)" },
    { "class": "build", "pattern": "^fastlane\\s+(?:\\S+\\s+)*?(?:gym|build\\w*)(?:\\s|$)" },
    { "class": "build", "pattern": "^cargo\\s+build\\s+(?:\\S+\\s+)*?--release(?:\\s|$)" },
    { "class": "build", "pattern": "^go\\s+(?:build|install)\\s+(?:\\S+\\s+)*?\\./\\.\\.\\.(?:\\s|$)" },
    { "class": "build", "pattern": "^goreleaser(?:\\s|$)" },
    { "class": "build", "pattern": "^docker\\s+(?:buildx\\s+)?build(?:\\s|$)" },
    { "class": "build", "pattern": "^docker(?:\\s+compose|-compose)\\s+(?:\\S+\\s+)*?(?:build|up\\s+(?:\\S+\\s+)*?--build)(?:\\s|$)" },
    { "class": "build", "pattern": "^cmake\\s+--build(?:\\s|$)" },
    { "class": "build", "pattern": "^pyinstaller(?:\\s|$)" },
    { "class": "build", "pattern": "^python3?\\s+-m\\s+(?:build|pyinstaller|nuitka)(?:\\s|$)" },
    { "class": "build", "pattern": "^python3?\\s+setup\\.py\\s+(?:sdist|bdist\\w*|build\\w*)(?:\\s|$)" },
    { "class": "build", "pattern": "^(?:poetry|uv|hatch|flit)\\s+build(?:\\s|$)" },

    { "class": "test", "pattern": "^(?:npm|pnpm|yarn|bun)\\s+(?:-{1,2}[\\w-]+(?:=\\S+)?\\s+(?:[^\\s-]\\S*\\s+)?)*(?:run(?:-script)?\\s+)?(?:test|t)(?::\\S+)?\\s*$" },
    { "class": "test", "pattern": "^(?:vitest|jest)(?:\\s+(?:run|--run|--ci|--coverage|--silent))*\\s*$" },
    { "class": "test", "pattern": "^(?:playwright\\s+test|cypress\\s+run)\\s*$" },
    { "class": "test", "pattern": "^(?:python3?\\s+-m\\s+)?pytest(?:\\s+(?:-q+|-v+|-x|-s|-ra|--tb=\\S+|--no-header|--cov\\S*|-n\\s*\\S+))*\\s*$" },
    { "class": "test", "pattern": "^python3?\\s+-m\\s+unittest(?:\\s+discover)?\\s*$" },
    { "class": "test", "pattern": "^(?:tox|nox|phpunit|rspec|ctest)\\s*$" },
    { "class": "test", "pattern": "^bundle\\s+exec\\s+rspec\\s*$" },
    { "class": "test", "pattern": "^dotnet\\s+test(?:\\s+--?(?:no-build|no-restore|nologo|(?:verbosity|v|configuration|c|logger)\\s+\\S+))*\\s*$" },
    { "class": "test", "pattern": "^dotnet\\s+test\\s+\\S+\\.slnx?(?:\\s|$)" },
    { "class": "test", "pattern": "^cargo\\s+test(?:\\s+--(?:workspace|all|release|all-features|no-fail-fast|quiet))*\\s*$" },
    { "class": "test", "pattern": "^go\\s+test\\s+(?:\\S+\\s+)*?\\./\\.\\.\\.(?:\\s|$)" },
    { "class": "test", "pattern": "^flutter\\s+test\\s*$" },
    { "class": "test", "pattern": "^gradlew?\\s+(?:--?[\\w-]+\\s+)*(?:clean\\s+)?(?:test|check)\\s*$" },
    { "class": "test", "pattern": "^mvnw?\\s+(?:-\\S+\\s+)*(?:test|verify)\\s*$" },

    { "class": "deploy", "pattern": "^(?:npm|pnpm|yarn|bun)\\s+(?:-{1,2}[\\w-]+(?:=\\S+)?\\s+(?:[^\\s-]\\S*\\s+)?)*(?:run(?:-script)?\\s+)?(?:release|publish|deploy)(?::\\S+)?(?:\\s|$)" },
    { "class": "deploy", "pattern": "^(?:vercel|netlify|firebase|fly|flyctl|wrangler|serverless|sls|eas)\\s+(?:\\S+\\s+)*?(?:deploy|publish|submit)(?:\\s|$)" },
    { "class": "deploy", "pattern": "^vercel\\s+(?:\\S+\\s+)*?--prod(?:\\s|$)" },
    { "class": "deploy", "pattern": "^(?:twine\\s+upload|cargo\\s+publish|gh\\s+release\\s+create|electron-forge\\s+publish|vsce\\s+publish)(?:\\s|$)" },
    { "class": "deploy", "pattern": "^docker\\s+(?:compose\\s+)?(?:\\S+\\s+)*?push(?:\\s|$)" },
    { "class": "deploy", "pattern": "^docker-compose\\s+(?:\\S+\\s+)*?push(?:\\s|$)" },
    { "class": "deploy", "pattern": "^mvnw?\\s+(?:\\S+\\s+)*?deploy(?:\\s|$)" },
    { "class": "deploy", "pattern": "^fastlane\\s+(?:\\S+\\s+)*?(?:beta|release|deploy|testflight|submit|upload\\w*|supply|pilot|deliver)(?:\\s|$)" },
    { "class": "deploy", "pattern": "^(?:terraform\\s+apply|kubectl\\s+apply|helm\\s+(?:install|upgrade))(?:\\s|$)" },

    { "class": "install", "pattern": "^(?:npm|pnpm|bun)\\s+(?:update|upgrade|up)(?:\\s|$)" },
    { "class": "install", "pattern": "^yarn\\s+(?:upgrade|up)(?:\\s|$)" },
    { "class": "install", "pattern": "^npm\\s+audit\\s+fix(?:\\s|$)" },
    { "class": "install", "pattern": "^cargo\\s+update(?:\\s|$)" }
  ]
}
